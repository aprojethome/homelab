# ==========================
# Sécurité & Secrets (TRÈS IMPORTANT)
# ==========================
# Ignorer tous les fichiers de variables d'environnement
.env
*.env

# Ignorer les clés et configs générées par WireGuard
docker/wireguard/config/
**/wireguard/config/
config/

# ==========================
# Sauvegardes & Archives
# ==========================
backup/*
!backup/.gitkeep
backups/
*.tar
*.tar.gz

# ==========================
# Données Docker & Logs
# ==========================
docker/*/data/
docker/*/volumes/
*.log

# ==========================
# Cache & Éditeurs
# ==========================
.cache/
.vscode/
.idea/

# ==========================
# Système & Conteneurs spécifiques
# ==========================
.DS_Store
Thumbs.db
docker/pihole/etc-pihole/cli_pw
docker/pihole/etc-pihole/*
!docker/pihole/etc-pihole/.gitkeep
